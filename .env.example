# ---------------------------------------------------------------------------
# MineAlts — environment variables
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# 1. PostgreSQL connection string (any Postgres 12+ / compatible provider)
#    Local example:  postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/minealts
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/minealts"

# 2. Discord OAuth2 application credentials.
#    Create the app at https://discord.com/developers/applications
#    then copy "Client ID" and "Client Secret" from the OAuth2 page.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# 3. Must EXACTLY match a Redirect URL registered on the Discord OAuth2 page.
#    For local development: http://localhost:3000/api/auth/discord/callback
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# 4. Secret used to sign auth material (OAuth state + PKCE cookies).
#    Generate one with:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# 5. Public origin of this site. Used to build absolute URLs and to validate
#    post-login redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
